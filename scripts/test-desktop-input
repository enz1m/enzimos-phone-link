#!/usr/bin/env python3
import os
from pathlib import Path
import runpy
import socket
import tempfile
import threading
import unittest
import json

module = runpy.run_path(str(Path(__file__).resolve().with_name('desktop-input')))
Commands, Controller = module['Commands'], module['Controller']


class InputTests(unittest.TestCase):
    def test_literal_text_and_bounded_unicode_chunks(self):
        decoder = Commands(1078, 2046)
        self.assertEqual(decoder.decode('text aa  aa'), [{'type': 'text', 'text': 'aa  aa'}])
        events = decoder.decode('text ' + '😀' * 2001)
        self.assertEqual([len(event['text']) for event in events], [1000, 1000, 1])
        self.assertTrue(all(len(event['text'].encode()) <= 4096 for event in events))

    def test_rejects_line_injection_and_raw_touch(self):
        for line in ['text hello\nkey 30 1', 'text \0', 'text \x7f', 'touch 0 down 10 20', 'key -1 1', 'key 30 7', 'key 900 1']:
            with self.assertRaises(ValueError):
                Commands(1078, 2046).decode(line)

    def test_pointer_relative_stays_in_source_bounds(self):
        decoder = Commands(1078, 2046)
        self.assertEqual(decoder.decode('pointer_relative -10000 10000'), [{'type': 'pointer', 'x': 0, 'y': 2045}])
        self.assertEqual(decoder.decode('pointer 20 40 1'), [{'type': 'pointer', 'x': 20., 'y': 40., 'click': True}])

    def test_scroll_preserves_fractional_units_and_stop(self):
        event = Commands(1078, 2046).decode('scroll_pixels 20 40 1.5 -2.75 1')[0]
        self.assertEqual((event['dx'], event['dy'], event['stop']), (1.5, -2.75, True))
        for number in ['NaN', 'inf', '-inf', '1000001']:
            with self.assertRaises(ValueError):
                Commands.number(number)

    def test_viewport_bounds(self):
        for width, height in [(0, 900), (8192, 900), (1080, 1)]:
            with self.assertRaises(ValueError):
                Commands(width, height)

    def test_peer_checked_content_connection_does_not_claim_input(self):
        with tempfile.TemporaryDirectory() as directory:
            path = str(Path(directory) / 'control')
            listener = socket.socket(socket.AF_UNIX)
            listener.bind(path)
            listener.listen(1)
            seen = []
            def serve():
                connection, _ = listener.accept()
                with connection, connection.makefile('rb') as reader:
                    request = json.loads(reader.readline())
                    seen.append(request)
                    connection.sendall(b'{"ok":true}\n')
            thread = threading.Thread(target=serve)
            thread.start()
            controller = Controller(path, 'ab' * 16, os.getpid(), bind_input=False)
            controller.call('content_size', token='ab' * 16, width=1078, height=1133, scale=2.75)
            controller.close()
            thread.join(timeout=2)
            listener.close()
            self.assertFalse(thread.is_alive())
            self.assertEqual(seen[0]['op'], 'content_size')

    def test_bad_endpoint_is_rejected_before_connect(self):
        for endpoint, token in [('relative', 'a'*32), ('/unused', 'secret'), ('/unused', 'g'*32)]:
            with self.assertRaises(ValueError):
                Controller(endpoint, token, os.getpid())


if __name__ == '__main__':
    unittest.main()
