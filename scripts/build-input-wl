#!/usr/bin/env bash
set -euo pipefail

# Build the Wayland-native input worker (enzremote-input-wl).
#
# Uses zwlr_virtual_pointer_v1 for pointer/touch/button/scroll input
# and zwp_virtual_keyboard_v1 for keyboard key events,
# scoped to the target WAYLAND_DISPLAY (does not affect the host desktop).

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
compositor_root=${ENZUI_COMPOSITOR_SETUP_DIR:?Set ENZUI_COMPOSITOR_SETUP_DIR to the initialized Shell source checkout}
build_dir=$project_root/target/input-wl
binary=$build_dir/enzremote-input-wl
read -r -a wayland_flags <<<"$(pkg-config --cflags --libs wayland-client xkbcommon)"

# Protocol files
ptr_xml=$compositor_root/vendor/Hyprland/protocols/wlr-virtual-pointer-unstable-v1.xml
kbd_xml=$compositor_root/vendor/Hyprland/protocols/virtual-keyboard-unstable-v1.xml

[[ -f "$ptr_xml" ]] || { printf 'virtual pointer protocol not found: %s\n' "$ptr_xml" >&2; exit 1; }
[[ -f "$kbd_xml" ]] || { printf 'virtual keyboard protocol not found: %s\n' "$kbd_xml" >&2; exit 1; }

mkdir -p -- "$build_dir"

# Generate pointer protocol
wayland-scanner client-header "$ptr_xml" "$build_dir/wlr-virtual-pointer-unstable-v1-client-protocol.h"
wayland-scanner private-code "$ptr_xml" "$build_dir/wlr-virtual-pointer-unstable-v1-protocol.c"

# Generate keyboard protocol
wayland-scanner client-header "$kbd_xml" "$build_dir/virtual-keyboard-unstable-v1-client-protocol.h"
wayland-scanner private-code "$kbd_xml" "$build_dir/virtual-keyboard-unstable-v1-protocol.c"

temporary=$(mktemp "$binary.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
cc -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -std=c11 -Wall -Wextra -Werror \
    -I"$build_dir" \
    "$project_root/tools/enzremote-input-wl.c" \
    "$build_dir/wlr-virtual-pointer-unstable-v1-protocol.c" \
    "$build_dir/virtual-keyboard-unstable-v1-protocol.c" \
    -o "$temporary" "${wayland_flags[@]}" -lrt
chmod 755 "$temporary"
mv -f -- "$temporary" "$binary"

printf '%s\n' "$binary"
